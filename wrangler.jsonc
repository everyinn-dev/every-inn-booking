/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",

	// ──────────────────────────────────────────────────────────────────────────────
	// This repo builds exactly TWO Workers. No preview/version URLs are used.
	//
	//   branch `main` → `saigonliving`      (production)  `npm run cf:deploy`
	//   branch `dev`  → `saigonliving-dev`  (UAT)         `npm run cf:deploy:dev`
	//
	// Top level below = PRODUCTION. `env.dev` = UAT. Bindings are NOT inherited between
	// them, so each block lists its own Service Bindings in full.
	// ─────────────────────────────────────────────────────────────────────────────

	"name": "saigonliving",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-03-07",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public",
		"text_decoder_cjk_decoder",
		"enable_global_performance_classes",
		"encoder_stream_spec_compliant_backpressure",
		"writable_stream_spec_compliant_writer"
	],
	// Version preview URLs are disabled: UAT is the separate `saigonliving-dev` Worker.
	"preview_urls": false,
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
        "upload_source_maps": false,
	// Production CDP_CORE binding is added at cutover (Phase 1.5, P-3). Until then the
	// loyalty lookup must not be merged to `main`.
	"env": {
		"dev": {
			"name": "saigonliving-dev",
			"main": ".open-next/worker.js",
			"preview_urls": false,
			"assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
			"services": [{ "binding": "CDP_CORE", "service": "everyinn-cdp-core-dev" }],
			"observability": { "enabled": true, "head_sampling_rate": 1 }
		}
	}
}
