/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",

	// ──────────────────────────────────────────────────────────────────────────────
	// This repo builds exactly TWO Workers. No preview/version URLs are used.
	//
	//   branch `main` → `saigonliving`      (production)  `npm run cf:deploy`
	//   branch `dev`  → `saigonliving-dev`  (UAT)         `npm run cf:deploy:dev`
	//
	// Top level below = PRODUCTION. `env.dev` = UAT. Bindings are NOT inherited between
	// them, so each block lists its own Service Bindings in full.
	// ─────────────────────────────────────────────────────────────────────────────

	"name": "saigonliving",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-03-07",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public",
		"text_decoder_cjk_decoder",
		"enable_global_performance_classes",
		"encoder_stream_spec_compliant_backpressure",
		"writable_stream_spec_compliant_writer"
	],
	// Version preview URLs are disabled: UAT is the separate `saigonliving-dev` Worker.
	"preview_urls": false,
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
        "upload_source_maps": false,
	// Production CDP_CORE binding (Phase 1.5, P-3 / S6).
	// LSB-3 guest self-booking: BOOKING_CORE (read-only storefront, caller landing-bff) + AGENT_CORE entrypoint
	// LandingApi (booking sessions, /checkin). Prod keeps WEB_BOOKING_ENABLED=false until the owner approves (R6).
	"services": [
		{ "binding": "CDP_CORE", "service": "everyinn-cdp-core" },
		{ "binding": "BOOKING_CORE", "service": "everyinn-booking-core" },
		{ "binding": "AGENT_CORE", "service": "everyinn-agent-core", "entrypoint": "LandingApi" }
	],
	"vars": { "WEB_BOOKING_ENABLED": "false" },
	// Workers Rate Limiting (per IP, short windows; long windows live in agent-core D1 — D4)
	"ratelimits": [
		{ "name": "SEARCH_RL", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } },
		{ "name": "HOLD_RL", "namespace_id": "4102", "simple": { "limit": 3, "period": 60 } },
		{ "name": "PAID_RL", "namespace_id": "4103", "simple": { "limit": 5, "period": 60 } },
		{ "name": "LOOKUP_RL", "namespace_id": "4104", "simple": { "limit": 5, "period": 60 } }
	],
	"env": {
		"dev": {
			"name": "saigonliving-dev",
			"main": ".open-next/worker.js",
			"preview_urls": false,
			"assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
			"services": [
				{ "binding": "CDP_CORE", "service": "everyinn-cdp-core-dev" },
				{ "binding": "BOOKING_CORE", "service": "everyinn-booking-core-dev" },
				{ "binding": "AGENT_CORE", "service": "everyinn-agent-core-dev", "entrypoint": "LandingApi" }
			],
			"vars": { "WEB_BOOKING_ENABLED": "true" },
			"ratelimits": [
				{ "name": "SEARCH_RL", "namespace_id": "4201", "simple": { "limit": 30, "period": 60 } },
				{ "name": "HOLD_RL", "namespace_id": "4202", "simple": { "limit": 3, "period": 60 } },
				{ "name": "PAID_RL", "namespace_id": "4203", "simple": { "limit": 5, "period": 60 } },
				{ "name": "LOOKUP_RL", "namespace_id": "4204", "simple": { "limit": 5, "period": 60 } }
			],
			"observability": { "enabled": true, "head_sampling_rate": 1 }
		}
	}
}
