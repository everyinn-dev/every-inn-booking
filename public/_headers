# https://developers.cloudflare.com/workers/static-assets/headers

# Global Security Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Ensure users immediately see new pricing & promotions after commit/build
/
  Cache-Control: public, max-age=0, must-revalidate

/room/*
  Cache-Control: public, max-age=0, must-revalidate

# Hashed assets: cache forever at the edge
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Room showcase videos: long cache with background revalidation & byte ranges
/videos/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  Accept-Ranges: bytes

# Static branding assets
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
/icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

